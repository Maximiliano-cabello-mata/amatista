# URL del backend FastAPI. Sin barra al final.
# Nota: si el frontend se publica con https (Cloudflare Pages), el backend
# también debe tener https; el navegador bloquea las llamadas a http.
# Producción (dominio oficial): VITE_API_URL=https://api.amatista-3d.me
# Sin esta variable: en amatista-3d.me se usa su API y en cualquier otro lado
# (también localhost) la VM 158.101.118.222:8000 (src/services/api.js).
# Déjala en localhost:8000 solo si corres el backend en tu computadora.
VITE_API_URL=http://localhost:8000
