              {
                "term": "Tres puntos",
                "definition": "Principal, relleno más suave y contraluz detrás."
              },
              {
                "term": "Muestras",
                "definition": "Cuántos rayos calcula Cycles por píxel: más muestras, menos ruido y más tiempo."
              },
              {
                "term": "Eliminar ruido",
                "definition": "Limpia el grano del render con pocas muestras."
              }
            ]
          },
