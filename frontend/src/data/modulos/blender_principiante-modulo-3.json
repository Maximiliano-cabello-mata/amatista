            "type": "concept_cards",
            "items": [
              {
                "term": "Espejo (Mirror)",
                "definition": "Copia la malla al otro lado de un eje. Modelas una mitad y la otra aparece sola."
              },
              {
                "term": "Subdivisión",
                "definition": "Divide cada cara y redondea la forma. Niveles 1 a 3 bastan casi siempre."
              },
              {
                "term": "Aplicar escala (Ctrl + A)",
                "definition": "Deja la escala en 1 sin cambiar la forma. Sin esto, los modificadores se deforman."
              }
            ]
          },
