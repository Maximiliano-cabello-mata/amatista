# Copia este archivo como backend/.env y completa los valores.
# backend/.env está en .gitignore: nunca subas contraseñas al repositorio.

# --- Oracle Autonomous Database ---
# Con el usuario de aplicación (sql/004_usuario_aplicacion.sql) usa
# DB_USER=AMATISTA_APP y DB_ESQUEMA=ADMIN. Sin él, ADMIN y DB_ESQUEMA vacío.
DB_USER=ADMIN
DB_PASSWORD=

# Opción A (recomendada): la cadena de conexión TLS completa de la consola de OCI
# (Autonomous Database > Conexión a la base de datos > TLS > la de nivel "high").
DB_DSN=

# Opción B: si DB_DSN está vacío, se arma una conexión tcps con estos datos.
DB_HOST=adb.us-ashburn-1.oraclecloud.com
DB_PORT=1522
DB_SERVICE=

# Esquema dueño de las tablas. Solo hace falta si DB_USER no es el dueño
# (por ejemplo AMATISTA_APP): cada conexión ejecuta
# ALTER SESSION SET CURRENT_SCHEMA = <DB_ESQUEMA>. Letras, números, _ $ #.
# DB_ESQUEMA=ADMIN

# Conexiones a Oracle por proceso de uvicorn: DB_POOL fijas + DB_POOL_EXTRA
# en picos (por defecto 5 + 5). El Free Tier admite pocas sesiones a la vez:
# procesos x (DB_POOL + DB_POOL_EXTRA) debe quedar por debajo de ese límite,
# dejando margen para Database Actions y el job de purga.
# DB_POOL=5
# DB_POOL_EXTRA=5

# --- Desarrollo sin Oracle ---
# Si defines DATABASE_URL se ignora todo lo de Oracle y se usa SQLite.
# DATABASE_URL=sqlite:///./amatista_local.db

# --- Cuentas y seguridad ---
# Correos que reciben el rol admin al registrarse o iniciar sesión,
# separados por comas. También: python herramientas/crear_admin.py correo@x
# AMATISTA_ADMINS=tu-correo@ejemplo.com

# Iteraciones de PBKDF2 para las contraseñas (por defecto 600000, OWASP).
# Subirlas no invalida las contraseñas viejas: se actualizan al iniciar sesión.
# AMATISTA_PBKDF2_ITER=600000

# 1 = las respuestas incluyen codigo_dev y el código sale en la consola.
# SOLO en desarrollo: en producción cualquiera podría confirmar correos ajenos.
# AMATISTA_MOSTRAR_CODIGOS=0

# 1 = no se puede iniciar sesión sin confirmar el correo (403).
# Por defecto 0: el alumno entra y confirma después.
# AMATISTA_REQUIERE_CONFIRMACION=0

# 1 = desactiva los límites de intentos por IP (429). Solo pruebas automáticas.
# AMATISTA_SIN_LIMITES=0

# 1 = la IP del alumno se toma de X-Forwarded-For (última entrada). Actívalo
# solo si el backend está detrás de tu proxy (por ejemplo Caddy); si no,
# cualquiera podría falsear su IP para saltarse los límites.
# AMATISTA_PROXY_CONFIABLE=0

# --- Correo (códigos de confirmación y recuperación) ---
# Sin SMTP_HOST no se envía nada: se registra un aviso en la consola sin el
# código. Puerto 587 con STARTTLS (465 = TLS directo).
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Remitente; si falta se usa SMTP_USER.
# SMTP_FROM=Amatista <no-responder@ejemplo.com>

# --- CORS ---
# localhost en cualquier puerto ya está permitido. Agrega otros orígenes
# separados por comas, por ejemplo el dominio de Cloudflare Pages.
# CORS_ORIGINS=https://amatista.pages.dev

# --- Add-on de Blender (instalador y vinculación de cuenta) ---
# Direcciones públicas que el instalador escribe en el add-on. Sin
# AMATISTA_URL_API se usa la de la petición (detrás de Caddy puede ser la
# interna); sin AMATISTA_URL_PWA, el origen si está en CORS_ORIGINS.
# AMATISTA_URL_API=https://api.amatista.example
# AMATISTA_URL_PWA=https://amatista.pages.dev
