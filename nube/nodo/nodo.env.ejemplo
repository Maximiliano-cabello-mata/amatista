# Configuración de un nodo de Amatista Cloud. Copia este archivo como nodo.env (NO lo subas a Git:
# el token es secreto) y ejecuta:  python amatista_nodo.py --config nodo.env ejecutar

# La API de Amatista (el coordinador).
AMATISTA_NODO_SERVIDOR=https://api.amatista-3d.tech
# El token de ESTE nodo: lo imprime `python amatista_nodo.py nuevo-token <nombre>` una sola vez.
AMATISTA_NODO_TOKEN=
# La dirección pública de este nodo (el hostname del túnel de Cloudflare que apunta a 127.0.0.1:8730).
AMATISTA_NODO_URL=https://nodo-casa.amatista-3d.tech

# --- Opcionales -----------------------------------------------------------------------------
# equilibrado (un núcleo físico por alumno) o denso (el doble de alumnos, renders más lentos).
AMATISTA_NODO_PERFIL=equilibrado
# Lo que se deja libre para el sistema. En la VM de Oracle, que también corre la API: 0.5 y 2.5.
AMATISTA_NODO_RESERVA_CPU=0
AMATISTA_NODO_RESERVA_RAM=2
# Fija el número de sesiones (vacío = las que caben según diagnostico).
AMATISTA_NODO_SESIONES=
# Minutos sin nadie conectado para cerrar una sesión y liberar el lugar.
AMATISTA_NODO_INACTIVIDAD_MIN=15
# Disco por sesión (carpeta Proyectos).
AMATISTA_NODO_DISCO_GB=1
AMATISTA_NODO_PUERTO=8730
