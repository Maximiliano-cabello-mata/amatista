{
  // Configuración del Worker que publica la PWA (Cloudflare Workers Builds).
  // El nombre debe ser igual al del Worker en el panel de Cloudflare.
  // docs/despliegue/2026-10-29_cloudflare_workers_builds.md
  "name": "amatista",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./frontend/dist"
  },
  // Las ramas que no son main no tienen comando de build en el panel: Wrangler
  // compila la PWA antes de publicar si frontend/dist no existe. En main el
  // build del panel ya la dejó lista y este paso no hace nada.
  "build": {
    "command": "test -f frontend/dist/index.html || (cd frontend && npm ci --no-audit --no-fund && npm run build)"
  },
  // Necesario para `wrangler preview`, el comando de las ramas que no son main.
  "previews": {}
}
