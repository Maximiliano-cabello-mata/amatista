{
  "schema": "amatista.practice/2",
  "id": "blender.bi.m3.diorama",
  "version": 3,
  "title": "Tu diorama en la galería",
  "level": 3,
  "description": "Montas tu aldea (o cualquier modelo tuyo) como diorama: encuadre, iluminación de tres puntos, motor de render y la imagen final guardada.",
  "intro": "La galería abre sus puertas: presenta tu mejor pieza como en un portafolio profesional.",
  "completion": "¡Tu diorama está en la galería! Terminaste el nivel Intermedio de Blender.",
  "estimatedMinutes": 30,
  "blender": {"min": "4.2"},
  "skills": ["bl-tres-puntos", "bl-camara", "bl-render", "bl-portafolio"],
  "tags": ["intermedio", "modulo-3", "proyecto"],
  "course": {"id": "blender_intermedio", "module": 3, "lesson": "bi3_practica"},
  "starter": {
    "scene": "keep",
    "from_practice": "blender.bi.m2.aldea",
    "note": "Trabaja sobre tu mi_aldea.blend (o cualquier modelo tuyo): Amatista no cambia nada al empezar."
  },
  "roles": {"diorama": {"label": "Diorama", "description": "La pieza principal que presentas en la galería."}},
  "tools": {"allowed": ["light.add", "camera.add", "render.f12", "view.numpad", "file.save"]},
  "pills": [
    {
      "id": "composicion",
      "title": "Regla de tercios",
      "text": "Activa la guía de tercios en la cámara (Propiedades de cámara › Composición) y coloca lo importante en un cruce de líneas.",
      "trigger": {"on": "start"}
    },
    {
      "id": "tres",
      "title": "Tres puntos otra vez",
      "text": "Principal delante a un lado, relleno más suave del otro y contraluz detrás. Lo aprendiste en el set de cine: ahora con tu propia pieza.",
      "trigger": {"on": "target", "target": "luces"}
    }
  ],
  "targets": [
    {
      "id": "diorama",
      "title": "Marca tu pieza",
      "validator": "role.count",
      "params": {"role": "diorama", "min": 1},
      "weight": 10,
      "tip": "Asigna el rol «Diorama» a tu modelo principal.",
      "hints": ["Abre mi_aldea.blend o modela algo nuevo.", "En la pestaña Amatista elige el rol «Diorama»."]
    },
    {
      "id": "camara",
      "title": "Cámara activa",
      "validator": "camera.active",
      "weight": 10,
      "requires": ["diorama"],
      "tip": "Shift+A › Cámara.",
      "hints": ["Ctrl+Numpad 0 la vuelve activa."]
    },
    {
      "id": "encuadre",
      "title": "Encuadre de portafolio",
      "validator": "camera.frames",
      "params": {"role": "diorama"},
      "weight": 20,
      "requires": ["camara"],
      "tip": "Mira tu diorama como en la foto final y pulsa Ctrl+Alt+0.",
      "hints": ["Numpad 0 para ver por la cámara."]
    },
    {
      "id": "luces",
      "title": "Tres puntos",
      "validator": "light.three_point",
      "params": {"role": "diorama"},
      "weight": 25,
      "requires": ["diorama"],
      "tip": "Principal y relleno delante a cada lado, contraluz detrás.",
      "hints": ["Mira desde arriba (7).", "Duplica la principal con Shift+D y baja su potencia: es el relleno."]
    },
    {
      "id": "motor",
      "title": "EEVEE o Cycles",
      "validator": "logic.any",
      "params": {
        "options": [
          {"validator": "render.engine", "params": {"engine": "EEVEE"}},
          {"validator": "render.engine", "params": {"engine": "CYCLES"}}
        ]
      },
      "weight": 5,
      "tip": "Elige EEVEE o Cycles en Propiedades › Render.",
      "hints": ["Workbench no sirve para la galería."]
    },
    {
      "id": "render",
      "title": "La foto final",
      "validator": "render.done",
      "params": {"min": 1},
      "weight": 20,
      "requires": ["encuadre", "luces"],
      "tip": "F12.",
      "hints": ["Imagen › Guardar como en la ventana del render."]
    },
    {
      "id": "guardar",
      "title": "Guarda el diorama",
      "validator": "file.named",
      "params": {"contains": "diorama"},
      "weight": 10,
      "requires": ["render"],
      "tip": "Ctrl+Shift+S: mi_diorama.blend.",
      "hints": ["Archivo › Guardar como."]
    }
  ],
  "review": ["blender.bi.m3.explora#motores", "blender.bpi.m2.tres-puntos#tres-puntos"],
  "reference": {
    "title": "Diorama en la galería",
